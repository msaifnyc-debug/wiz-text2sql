# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
region  = "us-east-1"
project = "text2sql"

# EKS
cluster_version    = "1.29"
node_instance_type = "t3.medium"

# GitHub Actions OIDC trust (for the pipelines). Set to your repo.
github_owner       = "muhammedsaif"
github_repo        = "wiz-text2sql"
create_github_oidc = true

# Intentional-weakness knobs (defaults already reproduce the weaknesses):
# ssh_ingress_cidr = "0.0.0.0/0"
# mongodb_version  = "5.0"

# Optional: paste an SSH public key to be able to log into the Mongo VM.
# vm_ssh_public_key = "ssh-ed25519 AAAA... you@host"
