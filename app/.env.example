# Copy to app/.env for local dev. In Kubernetes these come from a Secret.

# Fireworks (OpenAI-compatible) API key for the agent.
FIREWORKS_API_KEY=fw_your_key_here

# MongoDB: the app's system-of-record (users / uploads / history).
# Local default assumes a Mongo on localhost; in-cluster this points at the VM.
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=text2sql

# Session signing key (JWT). MUST be overridden with a strong random value.
SECRET_KEY=change-me-to-a-long-random-string

# Optional agent overrides (see src/config.py for all of them):
# FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b
# Upload guards:
# MAX_UPLOAD_BYTES=52428800
# QUERY_TIMEOUT_S=5
