# The build context is the REPO ROOT (docker build -f app/Dockerfile .), so this
# file - not app/.dockerignore - is the one Docker reads. Keep secrets, Terraform
# state, and the local venv out of the context entirely.
.git
.github
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.egg-info
**/.env
**/.env.*
**/*.pem
**/*.key
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
app/uploads
app/.cache
app/tests
infra
k8s
security
docs
scripts
